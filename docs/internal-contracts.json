{
  "status": "Proposed wire contracts awaiting Ammar and Daniel review. Database column names verified against Neon on 2026-11-22.",
  "userToken": {
    "algorithm": "RS256",
    "subject": "users.id UUID",
    "role": [
      "student",
      "alumni",
      "admin"
    ],
    "expiry": "required numeric exp",
    "issuer": "configurable JWT_ISSUER, defaults to alumnilink-accounts",
    "audience": "configurable JWT_AUDIENCE, defaults to alumnilink-api",
    "profileReceives": "public verification key only"
  },
  "browser": {
    "sessionStorageKey": "alumnilink.accessToken",
    "pages": [
      "profile.html",
      "privacy.html"
    ],
    "identityOwner": "Daniel"
  },
  "calls": [
    {
      "caller": "Profile",
      "receiver": "Identity",
      "method": "GET",
      "path": "/internal/users/:id/status",
      "authorization": "Bearer PROFILE_TO_ADMIN_TOKEN",
      "response": {
        "user": {
          "id": "UUID matching requested user",
          "role": "alumni | student | admin",
          "accountStatus": "active | suspended | pending | rejected"
        }
      }
    },
    {
      "caller": "Profile",
      "receiver": "Locations",
      "method": "POST",
      "path": "/internal/locations/resolve",
      "authorization": "Bearer PROFILE_TO_SEARCH_TOKEN",
      "request": {
        "name": "City, country"
      },
      "response": {
        "location": {
          "id": "positive integer already committed to the shared locations table"
        }
      },
      "failure": "400 unresolved input, 503 outage or malformed result. Profile changes remain uncommitted."
    },
    {
      "caller": "Search",
      "receiver": "Profile",
      "method": "GET",
      "path": "/internal/profiles/:id/contact?requestId=:requestId",
      "authorization": "Bearer SEARCH_TO_PROFILE_TOKEN",
      "headers": {
        "X-User-Token": "Student's original signed user token, verified independently",
        "X-Request-Id": "Optional UUID propagated into logs"
      },
      "response": {
        "contactEmail": "string"
      },
      "checks": [
        "valid service credential",
        "valid delegated Student token",
        "current Student active via Identity",
        "contact_requests.student_user_id matches token sub",
        "contact_requests.alumni_profile_id matches path",
        "contact_requests.status is accepted",
        "profile is_active true",
        "recipient Alumni account currently active",
        "recheck consent and both accounts in the final database query"
      ]
    }
  ],
  "privacy": {
    "fields": [
      "graduation_year",
      "company",
      "location",
      "industry",
      "bio",
      "skills"
    ],
    "defaultVisible": false,
    "contactEmail": "accepted-contact workflow only",
    "enforcementOwner": "Ammar must apply visibility to both directory responses and filters"
  },
  "deactivation": {
    "profile": "Ahmed updates alumni_profiles.is_active",
    "account": "Daniel updates users.account_status"
  },
  "schema": {
    "locationsId": "integer",
    "skillsId": "integer",
    "accountEligibility": "active",
    "contactRequestColumns": [
      "id",
      "student_user_id",
      "alumni_profile_id",
      "status"
    ]
  }
}
