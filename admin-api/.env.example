# Copy this file to .env and fill in the values. Never commit .env.
# Neon: Dashboard > Connect > copy the connection string
DATABASE_URL=
# Same value in all three backends, at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Same value in all three backends. Lets the backends call each other's /internal routes.
SERVICE_KEY=
# Cloudflare Turnstile secret key. Locally use the test key 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Comma-separated, no trailing slash. Add the deployed frontend address later.
CORS_ORIGINS=http://localhost:8080
PORT=3003

# Sign-up and login attempts allowed per minute before 429 (optional, these are the defaults).
AUTH_RATE_LIMIT_PER_IP=10
AUTH_RATE_LIMIT_PER_EMAIL=5
# Leave empty locally (counts in memory). On Floci/AWS: the DynamoDB table name.
# RATE_LIMIT_TABLE=alumnilink-identity-ratelimit

# Only for requests.http (REST Client reads them). The admin you made with npm run create-admin.
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=