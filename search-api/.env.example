# Copy this file to .env and fill in the values. Never commit .env.
# Neon: Dashboard > Connect > copy the connection string
DATABASE_URL=
# Same value in all three backends, at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Key the three backends use to call each other's /internal routes.
# Same value in all three backends, at least 32 random characters, different from TOKEN_SECRET.
# Never put it in frontend code.
SERVICE_KEY=
# Base addresses of the other two backends (no trailing slash).
# Local with the real services: http://localhost:3003 and http://localhost:3001
# Local with the stand-ins (npm run mock-services): http://localhost:4003 and http://localhost:4001
IDENTITY_API_URL=http://localhost:3003
PROFILE_API_URL=http://localhost:3001
# Comma-separated, no trailing slash. Add the deployed frontend address later.
CORS_ORIGINS=http://localhost:8080
PORT=3002

# ---- Floci / AWS (optional locally, used by npm run aws:deploy) ----
# Floci listens on http://localhost:4566 and accepts any credentials.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
# Requests per signed-in user per minute before 429.
RATE_LIMIT_PER_MINUTE=60
# Leave these empty to use .env and an in-memory counter. After npm run aws:deploy,
# set them to read secrets from Secrets Manager and count requests in DynamoDB:
# SECRET_ID=alumnilink/search
# RATE_LIMIT_TABLE=alumnilink-search-ratelimit
