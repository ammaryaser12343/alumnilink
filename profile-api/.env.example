FRONTEND_ORIGIN=http://localhost:8080
DATABASE_URL=
MIGRATION_DATABASE_URL=
TOKEN_SECRET=
SERVICE_KEY=
IDENTITY_API_URL=http://localhost:3003
SEARCH_API_URL=http://localhost:3002
# Floci deployment supplies these automatically. Set them for a native Node server if using Floci S3.
# PROFILE_PHOTO_BUCKET=alumnilink-profile-photos
# PROFILE_PHOTO_FLOCI_ENDPOINT=http://localhost:4566
# PROFILE_PHOTO_FLOCI_KEY= (base64-encoded 32-byte key; required when using the Floci endpoint)
