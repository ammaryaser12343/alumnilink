# Copy this file to .env and fill in the values. Never commit .env.
# Neon: Dashboard > Connect > copy the connection string
DATABASE_URL=
# Same value in all three backends, at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Comma-separated, no trailing slash. Add the deployed frontend address later.
CORS_ORIGINS=http://localhost:8080
PORT=3001
TURNSTILE_SECRET_KEY=
